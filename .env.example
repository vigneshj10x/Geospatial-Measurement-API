# Application Settings
PROJECT_NAME="Geospatial File Measurement API"
VERSION="0.1.0"
API_V1_STR="/api"

# Database Configuration (SQLite default, PostgreSQL/PostGIS URL configurable)
DATABASE_URL="sqlite:///./geospatial.db"

# Storage Configuration
UPLOAD_DIR="./uploads"

# Security & Resource Limits
MAX_UPLOAD_SIZE_BYTES=26214400       # 25 MB
MAX_UNCOMPRESSED_SIZE_BYTES=52428800 # 50 MB
MAX_ZIP_FILES=100
MAX_COMPRESSION_RATIO=100.0
